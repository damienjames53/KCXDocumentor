.DS_Store
__pycache__/
*.py[cod]
.venv/
venv/
node_modules/
.env
.env.*
!.env.example

# Local recordings and derived media can be large or sensitive.
samples/raw/*
!samples/raw/.gitkeep
samples/processed/*
!samples/processed/.gitkeep

# Generated deliverables and visual QA artifacts.
artifacts/generated/*
!artifacts/generated/.gitkeep
artifacts/qa/*
!artifacts/qa/.gitkeep

# Model files are installed locally and should not be committed.
models/*
!models/.gitkeep

