{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://keycentrix.local/kcxdocumentor/procedure_trace.schema.json",
  "title": "KCXDocumentor Procedure Trace",
  "type": "object",
  "required": ["schemaVersion", "recording", "segments"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "recording": {
      "type": "object",
      "required": ["sourceFile", "durationSeconds", "captureMode"],
      "properties": {
        "sourceFile": { "type": "string" },
        "durationSeconds": { "type": "number", "minimum": 0 },
        "targetApplication": { "type": "string" },
        "captureMode": { "type": "string" }
      },
      "additionalProperties": true
    },
    "segments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "start", "end", "speakerText", "visibleUiText", "actionHints", "candidateImages"],
        "properties": {
          "id": { "type": "string" },
          "start": { "type": "string" },
          "end": { "type": "string" },
          "speakerText": { "type": "string" },
          "confidence": {
            "type": "object",
            "properties": {
              "transcript": { "type": "number", "minimum": 0, "maximum": 1 },
              "ocr": { "type": "number", "minimum": 0, "maximum": 1 },
              "frameSelection": { "type": "number", "minimum": 0, "maximum": 1 },
              "overall": { "type": "number", "minimum": 0, "maximum": 1 },
              "needsHumanReview": { "type": "boolean" },
              "reasons": {
                "type": "array",
                "items": { "type": "string" }
              }
            },
            "additionalProperties": true
          },
          "visibleUiText": {
            "type": "array",
            "items": { "type": "string" }
          },
          "actionHints": {
            "type": "array",
            "items": { "type": "string" }
          },
          "candidateImages": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["path", "timestamp", "reason"],
              "properties": {
                "path": { "type": "string" },
                "timestamp": { "type": "string" },
                "reason": { "type": "string" },
                "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
                "reviewStatus": {
                  "type": "string",
                  "enum": ["pending", "approved", "rejected", "replacement-requested"]
                }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
